{
  "name": "@m2c2kit/core",
  "version": "0.3.36",
  "description": "The m2c2kit core functionality",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "npm run clean && tsc && rollup -c",
    "clean": "rimraf build dist .rollup.cache tsconfig.tsbuildinfo && del-cli assets/canvaskit-*.wasm",
    "test": "cd ../.. && npx env-cmd -f .env.jest jest --selectProjects @m2c2kit/core"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "dependencies": {
    "canvaskit-wasm": "0.41.0"
  },
  "devDependencies": {
    "@m2c2kit/build-helpers": "0.3.32",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "del-cli": "7.0.0",
    "findup-sync": "5.0.0",
    "rimraf": "6.1.3",
    "rollup": "4.60.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-polyfill-node": "0.13.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
