{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "exclude": ["src/__tests__/**/*"],
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2017",
      // to avoid type errors in the M2c2KitHelpers.flat() method, which uses
      // the FlatArray type
      "ES2019.Array"
    ]
  }
}
