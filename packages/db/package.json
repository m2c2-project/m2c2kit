{
  "name": "@m2c2kit/db",
  "version": "0.3.30",
  "description": "A local database for storing m2c2kit data on the device",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "npm run clean && tsc --build && rolldown -c",
    "clean": "rimraf build dist tsconfig.tsbuildinfo",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git",
    "directory": "packages/db"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "devDependencies": {
    "rimraf": "6.1.3",
    "rolldown": "1.0.0-rc.16",
    "rolldown-plugin-dts": "0.23.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@m2c2kit/core": "^0.3.30",
    "dexie": "4.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
