    "directory": "packages/session"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/m2c2-project/m2c2kit/issues"
  },
  "dependencies": {
    "@m2c2kit/core": "^0.3.30"
  },
  "devDependencies": {
    "@m2c2kit/build-helpers": "0.3.32",
    "rimraf": "6.1.3",
    "rolldown": "1.1.0",
    "rolldown-plugin-dts": "0.25.2",
    "typescript": "5.9.3"
  }
