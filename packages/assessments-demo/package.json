{
  "name": "@m2c2kit/assessments-demo",
  "description": "A demo of several m2c2kit assessments",
  "version": "0.8.32",
  "scripts": {
    "serve": "concurrently \"rolldown -c --watch --environment SERVE:true\" \"tsc --watch\" --names rolldown,typescript --prefix-colors auto,red",
    "build": "npm run clean && tsc && rolldown -c --environment PROD:true",
    "build-webview": "npm run clean-webview && rolldown -c rolldown.config.webview.mjs --environment PROD:true,NO_HASH:true",
    "build-sw": "npm run clean && rolldown -c --environment PROD:true,SERVICE_WORKER:true",
    "clean": "rimraf build dist *.tsbuildinfo schemas --glob",
    "clean-webview": "rimraf build dist-webview tsconfig.tsbuildinfo"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git",
    "directory": "packages/assessments-demo"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "private": true,
  "dependencies": {
    "@m2c2kit/addons": "0.3.36",
    "@m2c2kit/assessment-cli-starter": "0.8.33",
    "@m2c2kit/assessment-color-dots": "0.8.35",
    "@m2c2kit/assessment-color-shapes": "0.8.35",
    "@m2c2kit/assessment-grid-memory": "0.8.35",
    "@m2c2kit/assessment-symbol-search": "0.8.35",
    "@m2c2kit/core": "0.3.37",
    "@m2c2kit/db": "0.3.31",
    "@m2c2kit/embedding": "1.0.30",
    "@m2c2kit/session": "0.3.19",
    "@m2c2kit/survey": "0.3.32"
  },
  "devDependencies": {
    "@m2c2kit/build-helpers": "0.3.33",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "rimraf": "6.1.3",
    "rolldown": "1.1.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-serve": "3.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
