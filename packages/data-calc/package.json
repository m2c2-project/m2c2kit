{
  "name": "@m2c2kit/data-calc",
  "version": "0.8.7",
  "description": "A library for transformation and calculation of m2c2kit data",
  "main": "index.js",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "npm run clean && tsc --build && rolldown -c",
    "clean": "rimraf build dist tsconfig.tsbuildinfo",
    "test": "cd ../.. && npx env-cmd -f .env.jest jest --selectProjects @m2c2kit/data-calc"
  },
  "devDependencies": {
    "@m2c2kit/build-helpers": "0.3.32",
    "rimraf": "6.1.3",
    "rolldown": "1.1.0",
    "rolldown-plugin-dts": "0.25.2",
    "typescript": "5.9.3"
  },
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git",
    "directory": "packages/data-calc"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
