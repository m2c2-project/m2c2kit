{
  "name": "@m2c2kit/physics",
  "version": "0.1.23",
  "description": "Physics library for m2c2kit, based on the Matter.js engine",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "npm run clean && tsc --build && rolldown -c",
    "clean": "rimraf build dist tsconfig.tsbuildinfo",
    "test": "cd ../.. && npx env-cmd -f .env.jest jest --selectProjects @m2c2kit/physics"
  },
  "dependencies": {
    "@m2c2kit/core": "^0.3.30",
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "rimraf": "6.1.3",
    "rolldown": "1.0.0-rc.16",
    "rolldown-plugin-dts": "0.23.2",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git",
    "directory": "packages/physics"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "engines": {
    "node": ">=22"
  }
}
