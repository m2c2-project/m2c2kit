{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": false,
    "outDir": "build",
    "rootDir": "src",
    "removeComments": false
  },
  "include": ["./src/**/*.ts", "./src/**/*.js"],
  "exclude": ["**/__tests__", "**/*.test.ts"]
}
