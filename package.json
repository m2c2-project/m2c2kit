{
  "name": "m2c2kit",
  "version": "0.9.0",
  "description": "A library for cross-platform cognitive assessments",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/addons",
    "packages/assessment-cli-starter",
    "packages/assessment-color-dots",
    "packages/assessment-color-shapes",
    "packages/assessment-grid-memory",
    "packages/assessment-symbol-search",
    "packages/assessments-demo",
    "packages/automation-controller",
    "packages/automation-driver",
    "packages/build-helpers",
    "packages/cli",
    "packages/core",
    "packages/survey",
    "packages/db",
    "integration-tests/*",
    "packages/schema-util",
    "packages/embedding",
    "packages/schematics",
    "packages/physics",
    "packages/session",
    "packages/assessments-registry",
    "packages/data-calc",
    "packages/test-helpers"
  ],
  "scripts": {
    "build": "turbo run build build-webview copy-modules --filter=!@m2c2kit/automation-controller --filter=!@m2c2kit/automation-driver",
    "test": "npx env-cmd -f .env.jest -- jest",
    "integration-test": "docker compose down && docker compose build m2c2kit registry testapp testmodule --pull && docker compose build publish && docker compose up --exit-code-from m2c2kit",
    "copy-modules": "rimraf examples/no-js-bundler-development/modules && node scripts/copy-m2c2kit-modules.mjs",
    "publish-updated": "node scripts/publish-updated-packages.mjs",
    "prepare": "husky"
  },
  "type": "module",
  "keywords": [],
  "author": {
    "name": "Scott T. Yabiku",
    "email": "syabiku@gmail.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/m2c2-project/m2c2kit.git"
  },
  "homepage": "https://m2c2-project.github.io/m2c2kit",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "30.0.0",
    "@types/semver": "7.7.1",
    "concurrently": "10.0.3",
    "cpy-cli": "4.2.0",
    "cross-env": "10.1.0",
    "env-cmd": "11.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "find-up": "8.0.0",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "^17.0.7",
    "prettier": "3.8.3",
    "pyodide": "0.29.4",
    "semver": "7.8.3",
    "syncpack": "15.3.1",
    "ts-jest": "29.4.11",
    "ts-jest-mock-import-meta": "1.3.2",
    "ts-node": "10.9.2",
    "turbo": "2.9.16",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
